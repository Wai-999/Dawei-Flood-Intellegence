FLOOD_ENV=production
FLOOD_DOMAIN=your-internal-domain.example
TLS_CONTACT_EMAIL=operator@example.com
FLOOD_DATABASE=/data/flood.sqlite3
FLOOD_PUBLIC_ORIGIN=https://your-internal-domain.example
FLOOD_SECURE_COOKIES=1
FLOOD_TRUSTED_PROXIES=172.29.0.2
FLOOD_SOURCE_DIRECTORY=/data/source
FLOOD_BACKUP_DIRECTORY=/backups
FLOOD_BACKUP_SIGNING_KEY_FILE=/run/secrets/backup-signing.key
FLOOD_BACKUP_INTERVAL_SECONDS=3600
FLOOD_BACKUP_RETENTION_DAYS=30
# Keep integrations disabled until the operator has commissioned them.
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-token
TELEGRAM_USERS_FILE=/run/secrets/telegram-users.json
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_SHEET_ID=YOUR_SHEET_ID
